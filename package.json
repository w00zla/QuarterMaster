{
  "name": "sc-quartermaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "db:up": "scripts/dev-db.sh up",
    "db:down": "scripts/dev-db.sh down",
    "db:psql": "scripts/dev-db.sh psql",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "catalog:extract": "node src/catalog/extract/cli.ts",
    "catalog:import": "node --env-file-if-exists=.env src/catalog/import/cli.ts",
    "loc:import": "node --env-file-if-exists=.env src/catalog/import/loc-cli.ts",
    "packshot:targets": "node --env-file-if-exists=.env src/catalog/thumb-targets-cli.ts",
    "thumbs:build": "cargo run --release --quiet --manifest-path tools/thumbs/Cargo.toml --",
    "adminapp": "node --env-file-if-exists=.env src/adminapp/main.ts",
    "adminapp:dev": "pnpm --filter sc-quartermaster-adminapp dev",
    "adminapp:build": "pnpm --filter sc-quartermaster-adminapp build",
    "adminapp:watch": "node --watch --env-file-if-exists=.env src/adminapp/main.ts",
    "webapp": "node --env-file-if-exists=.env src/webapp/main.ts",
    "webapp:watch": "node --watch --env-file-if-exists=.env src/webapp/main.ts",
    "webapp:dev": "pnpm --filter sc-quartermaster-webapp dev",
    "webapp:build": "pnpm --filter sc-quartermaster-webapp build",
    "bot": "node --env-file-if-exists=.env src/bot/main.ts",
    "bot:register": "node --env-file-if-exists=.env src/bot/register.ts",
    "ext": "node --env-file-if-exists=.env src/ext/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1"
}
