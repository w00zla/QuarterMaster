{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quartermaster",
  "identifier": "com.w00zla.quartermaster",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Quartermaster",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "decorations": false,
        "backgroundColor": "#0a1d29"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBMDg1OTQxNEZENzQzMDcKUldRSFE5ZFBRVmtJQ2xqaUp5TkVOb2tjdmJ1MENQWmJZcU12TjlqakJDVEUvS0dlSER0c2dSNG8K"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
