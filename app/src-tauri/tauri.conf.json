{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quartermaster",
  "identifier": "com.w00zla.quartermaster",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Quartermaster",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "decorations": false,
        "backgroundColor": "#0a1d29",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --force-color-profile=srgb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQzNEREFCOTI3RDFENzIKUldSeUhYMlNxOTNETUluS2E2YTMwMldpbDhjd3NqOHNnRUhrN1Zkb2p3TXlxK0pMN01oM0wxQnAK",
      "dangerousInsecureTransportProtocol": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Game",
    "icon": [
      "../../companion/src-tauri/icons/32x32.png",
      "../../companion/src-tauri/icons/128x128.png",
      "../../companion/src-tauri/icons/128x128@2x.png",
      "../../companion/src-tauri/icons/icon.icns",
      "../../companion/src-tauri/icons/icon.ico"
    ]
  }
}
