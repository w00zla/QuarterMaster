{
  "name": "sc-quartermaster-companion",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "tauri": "tauri",
    "companion:start": "tauri dev",
    "companion:fast": "node scripts/by-platform.mjs build:fast:",
    "companion:build": "node scripts/by-platform.mjs build:",
    "build:linux": "NO_STRIP=true tauri build --bundles appimage",
    "build:windows": "tauri build --bundles nsis --config src-tauri/tauri.setup.conf.json",
    "build:fast:linux": "tauri build --no-bundle -- --profile fast",
    "build:fast:windows": "tauri build --no-bundle --config src-tauri/tauri.setup.conf.json -- --profile fast",
    "directml": "node scripts/fetch-directml.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-log": "2.10.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.12"
  },
  "packageManager": "pnpm@12.16.1"
}
