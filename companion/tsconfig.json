{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../src/webapp/api-types.ts", "../src/stock/material-names.ts", "../src/stock/component-stats.ts","../adminapp/src/components/Icon.vue", "../adminapp/src/components/Dropdown.vue", "../adminapp/src/components/Tooltip.vue", "../adminapp/src/components/ColumnHead.vue", "../adminapp/src/components/HelpTip.vue", "../adminapp/src/tableColumns.ts", "../webapp/src/components/ConfirmDialog.vue", "../webapp/src/components/Picker.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
