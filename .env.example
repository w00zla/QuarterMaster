# Dev database (see scripts/dev-db.sh)
DATABASE_URL=postgres://quartermaster:quartermaster@localhost:5432/quartermaster
# Throwaway database for integration tests; tests touching the DB only run when this is set
TEST_DATABASE_URL=postgres://quartermaster:quartermaster@localhost:5432/quartermaster_test
# Admin web UI (pnpm web); both required, HTTP basic auth
WEB_USER=
WEB_PASSWORD=
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Discord bot (pnpm bot); token and application ID from the Discord developer portal
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register commands on this server only (instant, for development); empty = global
DISCORD_DEV_GUILD_ID=
# Deployment (compose.yaml), each e.g. openssl rand -hex 32. compose.yaml sets DATABASE_URL,
# WEB_HOST and WEB_PORT itself. POSTGRES_PASSWORD: the superuser "postgres", only applied on a
# fresh volume. QM_OWNER_PASSWORD (migrations) and QM_APP_PASSWORD (bot, admin): go into URLs,
# URL-safe characters only; a change applies with the next scripts/deploy.sh.
POSTGRES_PASSWORD=
QM_OWNER_PASSWORD=
QM_APP_PASSWORD=
