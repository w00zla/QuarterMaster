# Dev database (see scripts/dev-db.sh)
DATABASE_URL=postgres://quartermaster:quartermaster@localhost:5432/quartermaster
# Throwaway database for integration tests; tests touching the DB only run when this is set
TEST_DATABASE_URL=postgres://quartermaster:quartermaster@localhost:5432/quartermaster_test
# Admin web UI (pnpm adminapp); both required, HTTP basic auth
ADMINAPP_USER=
ADMINAPP_PASSWORD=
ADMINAPP_HOST=127.0.0.1
ADMINAPP_PORT=3000
# Discord bot (pnpm bot); token and application ID from the Discord developer portal
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register commands on this server only (instant, for development); empty = global
DISCORD_DEV_GUILD_ID=
# UEX API (pnpm ext, the third-party pull): bearer token of an app on https://uexcorp.space/api/apps
UEX_TOKEN=
# User web app (pnpm webapp). Client ID = DISCORD_APP_ID; the client secret is on the
# application's OAuth2 page (not the bot token). WEBAPP_ORIGIN is where the browser sees the app (the bot links there too);
# the OAuth2 redirect to register is WEBAPP_ORIGIN + /auth/callback. Always "localhost", never
# 127.0.0.1 (a different cookie host). WEBAPP_TRUST_PROXY=1 only behind Caddy.
DISCORD_CLIENT_SECRET=
WEBAPP_ORIGIN=http://localhost:5174
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=3002
WEBAPP_TRUST_PROXY=
# Companion app release the web app hands out (companion.json + files, see src/webapp/companion.ts);
# default local/companion
#COMPANION_DIR=
# Item thumbnails the web app serves under /thumbs (s/, m/, l/ + thumbs.json from pnpm icons:pack);
# default local/thumbs. The bot reads the same directory (which items have one)
#THUMBS_DIR=
# Public base URL of that directory for the bot's thumbnails in Discord (${THUMBS_URL}/l/<file>);
# default WEBAPP_ORIGIN + /thumbs unless that is localhost/127.0.0.1 (Discord cannot reach it): for a
# local bot upload local/thumbs somewhere public and set this; neither = no thumbnails
#THUMBS_URL=
# Deployment (compose.yaml), each e.g. openssl rand -hex 32. compose.yaml sets DATABASE_URL,
# ADMINAPP_HOST, ADMINAPP_PORT, WEBAPP_HOST, WEBAPP_PORT, WEBAPP_TRUST_PROXY, COMPANION_DIR and THUMBS_DIR
# itself (the companion release goes into local/companion/ of the checkout, the thumbnails into
# local/thumbs/); WEBAPP_ORIGIN there is the public https:// origin, DISCORD_CLIENT_SECRET the production application's. POSTGRES_PASSWORD: the
# superuser "postgres", only applied on a fresh volume. QM_OWNER_PASSWORD (migrations), QM_APP_PASSWORD
# (bot, admin) and QM_WEB_PASSWORD (user web app): go into URLs, URL-safe characters only; a change
# applies with the next scripts/deploy.sh.
POSTGRES_PASSWORD=
QM_OWNER_PASSWORD=
QM_APP_PASSWORD=
QM_WEB_PASSWORD=
