{
  // Admin web UI in development: API restarting on changes (pnpm web:watch, :3000) + Vite with hot reload (pnpm web:dev, :5173).
  // Run "web: dev", then open http://127.0.0.1:5173 (basic auth from .env).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "web: backend",
      "type": "shell",
      "command": "pnpm web:watch",
      "isBackground": true,
      "presentation": { "group": "web-dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "web-api",
        "pattern": { "regexp": "^\\0never$", "file": 1, "line": 2, "message": 3 },
        "background": { "activeBegin": true, "beginsPattern": "^> .* web$", "endsPattern": "Backend \\(API\\) on http" }
      }
    },
    {
      "label": "web: frontend",
      "type": "shell",
      "command": "pnpm web:dev",
      "isBackground": true,
      "presentation": { "group": "web-dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "web-vite",
        "pattern": { "regexp": "^\\0never$", "file": 1, "line": 2, "message": 3 },
        "background": { "activeBegin": true, "beginsPattern": "^> vite$", "endsPattern": "ready in \\d+ ms" }
      }
    },
    {
      "label": "web: dev",
      "dependsOn": ["web: backend", "web: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
