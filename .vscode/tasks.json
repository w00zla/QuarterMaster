{
  // Admin web UI in development: API restarting on changes (pnpm adminapp:watch, :3000) + Vite with hot reload (pnpm adminapp:dev, :5173).
  // Run "adminapp: dev", then open http://127.0.0.1:5173 (basic auth from .env).
  // User web app in development: dev DB (pnpm db:up), then backend (pnpm webapp:watch, :3002), Vite (pnpm webapp:dev, :5174)
  // and the Discord bot (pnpm bot, keeps the roster current). Run "webapp: dev", then open http://localhost:5174 (not 127.0.0.1).
  // Everything at once: "all: dev" (dev DB, both web apps, the bot and the third-party pull, pnpm ext, which needs UEX_TOKEN in .env).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "adminapp: backend",
      "type": "shell",
      "command": "pnpm adminapp:watch",
      "isBackground": true,
      "presentation": { "group": "adminapp-dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "adminapp-api",
        "pattern": { "regexp": "^\\0never$", "file": 1, "line": 2, "message": 3 },
        "background": { "activeBegin": true, "beginsPattern": "^(> .* adminapp:watch|Restarting)", "endsPattern": "Backend \\(API\\) on http" }
      }
    },
    {
      "label": "adminapp: frontend",
      "type": "shell",
      "command": "pnpm adminapp:dev",
      "isBackground": true,
      "presentation": { "group": "adminapp-dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "adminapp-vite",
        "pattern": { "regexp": "^\\0never$", "file": 1, "line": 2, "message": 3 },
        "background": { "activeBegin": true, "beginsPattern": "^> vite$", "endsPattern": "ready in \\d+ ms" }
      }
    },
    {
      "label": "adminapp: dev",
      "dependsOn": ["adminapp: backend", "adminapp: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "db: up",
      "type": "shell",
      "command": "pnpm db:up",
      // Windows: Postgres runs as a service (no Podman), only check that it is up
      "windows": { "command": "sc.exe query postgresql-x64-18 | findstr RUNNING" },
      "presentation": { "group": "webapp-dev", "panel": "shared", "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "webapp: backend",
      "type": "shell",
      "command": "pnpm webapp:watch",
      "isBackground": true,
      "presentation": { "group": "webapp-dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "webapp-api",
        "pattern": { "regexp": "^\\0never$", "file": 1, "line": 2, "message": 3 },
        "background": { "activeBegin": true, "beginsPattern": "^(> .* webapp:watch|Restarting)", "endsPattern": "User web app on http" }
      }
    },
    {
      "label": "webapp: frontend",
      "type": "shell",
      "command": "pnpm webapp:dev",
      "isBackground": true,
      "presentation": { "group": "webapp-dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "webapp-vite",
        "pattern": { "regexp": "^\\0never$", "file": 1, "line": 2, "message": 3 },
        "background": { "activeBegin": true, "beginsPattern": "^> vite$", "endsPattern": "ready in \\d+ ms" }
      }
    },
    {
      "label": "bot",
      "type": "shell",
      "command": "pnpm bot",
      "isBackground": true,
      "presentation": { "group": "webapp-dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "bot",
        "pattern": { "regexp": "^\\0never$", "file": 1, "line": 2, "message": 3 },
        "background": { "activeBegin": true, "beginsPattern": "^> .* bot( |$)", "endsPattern": "Logged in as" }
      }
    },
    {
      "label": "webapp: servers",
      "dependsOn": ["webapp: backend", "webapp: frontend", "bot"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "webapp: dev",
      "dependsOn": ["db: up", "webapp: servers"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "ext",
      "type": "shell",
      "command": "pnpm ext",
      "isBackground": true,
      "presentation": { "group": "all-dev", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": {
        "owner": "ext",
        "pattern": { "regexp": "^\\0never$", "file": 1, "line": 2, "message": 3 },
        "background": { "activeBegin": true, "beginsPattern": "^> .* ext( |$)", "endsPattern": "^UEX refineries_methods" }
      }
    },
    {
      "label": "all: servers",
      "dependsOn": ["adminapp: backend", "adminapp: frontend", "webapp: backend", "webapp: frontend", "bot", "ext"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "all: dev",
      "dependsOn": ["db: up", "all: servers"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
