    "catalog.localization_effective": {
      "columns": {
        "lang": {
          "name": "lang",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "key": {
          "name": "key",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "value": {
          "name": "value",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "source": {
          "name": "source",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT DISTINCT ON (l.lang, l.key) l.lang, l.key, l.value, l.source\n  FROM \"catalog\".\"localization\" l\n  JOIN \"catalog\".\"localization_source\" s ON s.source = l.source AND s.lang = l.lang\n  ORDER BY l.lang, l.key, s.priority DESC, l.source",
      "name": "localization_effective",
      "schema": "catalog",
      "isExisting": false,
      "materialized": false
    }
  },
